{
  "name": "LilyGo T-Display S3",
  "url": "https://github.com/Xinyuan-LilyGO/T-Display-S3",
  "vendor": "LILYGO",
  "frameworks": ["arduino"],
  "connectivity": ["wifi", "bluetooth"],
  "build": {
    "core": "esp32",
    "mcu": "esp32s3",
    "variant": "esp32s3",
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "partitions": "default_16MB.csv",
    "arduino": {
      "memory_type": "qio_opi"
    },
    "extra_flags": [
      "-DBOARD_HAS_PSRAM",
      "-DLILYGO_T_DISPLAY_S3",
      "-DUSER_SETUP_LOADED",
      "-DUSE_HSPI_PORT",
      "-DST7789_DRIVER=1",
      "-DINIT_SEQUENCE_3=1",
      "-DCGRAM_OFFSET=1",
      "-DTFT_RGB_ORDER=TFT_RGB",
      "-DTFT_INVERSION_ON",
      "-DTFT_PARALLEL_8_BIT",
      "-DTFT_WIDTH=170",
      "-DTFT_HEIGHT=320",
      "-DTFT_CS=6",
      "-DTFT_DC=7",
      "-DTFT_RST=5",
      "-DTFT_WR=8",
      "-DTFT_RD=9",
      "-DTFT_D0=39",
      "-DTFT_D1=40",
      "-DTFT_D2=41",
      "-DTFT_D3=42",
      "-DTFT_D4=45",
      "-DTFT_D5=46",
      "-DTFT_D6=47",
      "-DTFT_D7=48",
      "-DTFT_BL=38",
      "-DTFT_BACKLIGHT_ON=HIGH",
      "-DLOAD_GLCD=1",
      "-DLOAD_FONT2=1",
      "-DLOAD_FONT4=1",
      "-DLOAD_FONT6=1",
      "-DLOAD_FONT7=1",
      "-DLOAD_FONT8=1",
      "-DLOAD_GFXFF=1",
      "-DSMOOTH_FONT=1",
      "-DBTN_A_PIN=14",
      "-DBTN_B_PIN=0",
      "-DBTN_C_PIN=-1"
    ]
  },
  "upload": {
    "maximum_size": 16777216,
    "maximum_ram_size": 327680,
    "speed": 921600,
    "flash_size": "16MB",
    "require_upload_port": true
  },
  "monitor": { "speed": 115200 }
}
